# Public Supabase client config — SAME Supabase project used by the Colega desktop app.
# Safe to expose to the browser: the anon/publishable key only works within Row Level
# Security policies, it never bypasses them. Get these from the desktop app's .env
# (VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY) or Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of this website, used to build email confirmation / password reset redirect
# links. Use http://localhost:3000 in development; https://colegapro.com in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Server-only — NEVER prefix with NEXT_PUBLIC_, NEVER expose to the browser ----------
# Supabase dashboard -> Project Settings -> API -> service_role secret. Used only by the admin
# panel's server-only client (src/lib/supabase/admin.ts) for operations RLS genuinely cannot
# express (banning a user, forcing organization membership fixes). Required for /admin to work
# at all beyond read-only pages; the rest of the site (public pages, normal user auth) does not
# need it. Keep it in .env.local locally; in production it must be configured as a PRIVATE
# (non-public) Netlify environment variable, never one exposed to the client build.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Paddle Billing ----------
# Public: Paddle > Developer tools > Authentication -> client-side token. "sandbox" or "production";
# price IDs in src/lib/paddle/prices.ts are environment-specific.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Server-only — NEVER prefix with NEXT_PUBLIC_. Private Netlify env vars in production.
# PADDLE_API_KEY: Paddle > Developer tools > Authentication -> API key.
# PADDLE_WEBHOOK_SECRET: the secret of the notification destination pointing at /api/webhooks/paddle.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
